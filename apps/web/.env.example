VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIRESTORE_DATABASE_ID=(default)
# Optional local Firebase emulator suite
VITE_USE_FIREBASE_EMULATOR=false
# Free mentor beta is enabled by default. Set false to pause it in this build.
# The OpenRouter API key belongs only in Firebase Secret Manager, never VITE_*.
VITE_MENTOR_AVAILABLE=true

# Legal pages stay labeled as drafts until the real details are confirmed.
VITE_LEGAL_OPERATOR=
VITE_LEGAL_CONTACT_EMAIL=este.t1ger.oficial.app@gmail.com
VITE_LEGAL_LOCATION=
VITE_LEGAL_EFFECTIVE_DATE=
# Set true only after privacy, terms, retention, deletion, age scope and jurisdictions are reviewed.
VITE_LEGAL_PUBLISHED=false

# Optional product analytics, loaded only after a browser privacy choice.
# Public project token, NEVER a PostHog personal API key.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
