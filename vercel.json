{
  "rewrites": [
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/en", "destination": "/guides/en/index.html" },
    { "source": "/guides/es", "destination": "/guides/es/index.html" },
    { "source": "/guides/:language/:slug", "destination": "/guides/:language/:slug/index.html" },
    { "source": "/__/auth/:path*", "destination": "https://t1ger-69d6a.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/init.json", "destination": "https://t1ger-69d6a.firebaseapp.com/__/firebase/init.json" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/early-access/success", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/app", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/app/", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/app/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/terms", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/privacy", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/early-access/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/__/auth/:path*",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
